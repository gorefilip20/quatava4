{
  "id": "7848B8AC",
  "name": "quatava-v1",
  "private": true,
  "version": "5.7.1",
  "scripts": {
    "dev": "concurrently \"pnpm --filter frontend dev\" \"pnpm --filter backend dev\"",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:all": "NODE_OPTIONS='--max-old-space-size=2560' pnpm --filter frontend build && pnpm --filter backend build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "NODE_OPTIONS='--max-old-space-size=2560' pnpm --filter frontend build",
    "build:permission": "node tools/build-permission.js",
    "start": "pm2 start production.config.js --env production",
    "start:thread": "pm2 start production.thread.config.js --env production",
    "start:frontend": "pnpm --filter frontend start",
    "start:backend": "pnpm --filter backend start",
    "stop": "pm2 stop all 2>/dev/null || echo 'No PM2 processes to stop'",
    "updator": "NODE_OPTIONS='--max-old-space-size=2560' pnpm stop && pnpm update-packages-quick && pnpm build:backend && pnpm start:backend && node -e \"console.log('⏳ Waiting 30 seconds before seeding...'); setTimeout(() => { console.log('✅ Wait complete, proceeding with seed...'); process.exit(0); }, 30000)\" && pnpm stop && pnpm seed && pnpm build:all && pnpm start",
    "update-packages": "node tools/update-packages.js",
    "update-packages-quick": "pnpm --filter backend update && pnpm --filter frontend update && pnpm update",
    "seed": "pnpm --filter backend seed",
    "test": "pnpm --filter backend test",
    "test:watch": "pnpm --filter backend test:watch",
    "test:coverage": "pnpm --filter backend test:coverage",
    "test:integration": "pnpm --filter backend test:integration",
    "test:unit": "pnpm --filter backend test:unit",
    "extract:permission": "node tools/extract-permission.js",
    "i18n": "cd tools/translation-manager && npm start",
    "i18n:install": "cd tools/translation-manager && npm install",
    "btc-node:setup": "node scripts/btc-node-setup.mjs",
    "update-cache-version": "node docs/update-cache-version.js",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,md,mdx,css,scss}\" --ignore-path .prettierignore",
    "lint": "eslint frontend --fix --ext .ts,.tsx"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "16.2.4",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "8.0.0-alpha.26",
    "@typescript-eslint/parser": "8.0.0-alpha.26",
    "concurrently": "^7.6.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "ethers": "^6.16.0",
    "fast-glob": "^3.3.3",
    "globals": "^15.15.0",
