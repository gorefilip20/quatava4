{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "module": "CommonJS",
    "target": "ES2018",
    "types": ["node", "jest"],
    "typeRoots": ["./node_modules/@types", "./types", "../node_modules/@types"],
    "paths": {
      "@b/*": ["src/*"],
      "@db/*": ["models/*"]
    }
  },
  "include": [
    "index.ts",
    "module-alias-setup.ts",
    "src/**/*.ts",
    "models/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
